# ESP32-S3 NanoPod board profile.
CONFIG_MICROPIXEL_BOARD_ESP32_S3_NANOPOD=y
CONFIG_MICROPIXEL_S3_NANOPOD_LVGL_DOUBLE_BUFFER=y

# Use two 40-row partial LVGL buffers for CO5300 QSPI updates.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
# CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM is not set

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
